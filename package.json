{
  "name": "voicescribe",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "pods": "cd ios && pod install && cd ..",
    "build:ios": "cd ios && xcodebuild -workspace VoiceScribe.xcworkspace -scheme VoiceScribe -configuration Release",
    "build:android": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.75.4",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "react-native-safe-area-context": "^4.11.0",
    "react-native-screens": "^3.34.0",
    "react-native-gesture-handler": "^2.18.1",
    "react-native-reanimated": "^3.15.1",
    "@shopify/react-native-skia": "^1.4.2",
    "zustand": "^4.5.5",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "react-native-fs": "^2.20.0",
    "@react-native-community/audio-toolkit": "^2.0.3",
    "react-native-iap": "^12.15.3",
    "@notifee/react-native": "^9.0.0",
    "react-native-share": "^10.2.1",
    "react-native-document-picker": "^9.3.1",
    "@react-native-community/netinfo": "^11.3.2",
    "react-native-vector-icons": "^10.1.0",
    "date-fns": "^3.6.0",
    "uuid": "^10.0.0",
    "immer": "^10.1.1",
    "expo-sqlite": "^14.0.6",
    "drizzle-orm": "^0.33.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "0.75.4",
    "@react-native/eslint-config": "0.75.4",
    "@react-native/metro-config": "0.75.4",
    "@react-native/typescript-config": "0.75.4",
    "@types/react": "^18.3.3",
    "@types/react-test-renderer": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "typescript": "5.5.4",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "jest": "^29.7.0",
    "@testing-library/react-native": "^12.5.3",
    "@testing-library/jest-native": "^5.4.3",
    "react-test-renderer": "18.2.0",
    "detox": "^20.26.2",
    "drizzle-kit": "^0.24.2"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": ["@testing-library/jest-native/extend-expect"],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@react-navigation|react-native-reanimated|react-native-gesture-handler|@shopify/react-native-skia)/)"
    ]
  }
}
